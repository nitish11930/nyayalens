{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NyayaLens Legal Notice Analysis",
  "description": "Structured output schema for Gemini legal notice analysis. All fields must be derived strictly from the uploaded document.",
  "type": "object",
  "required": [
    "noticeCategory",
    "plainEnglishSummary",
    "keyFacts",
    "deadline",
    "documentExcerpts",
    "attentionItems",
    "lawyerQuestions",
    "hindiTranslation",
    "legalHelpResources",
    "safetyDisclaimer",
    "confidenceScore"
  ],
  "properties": {
    "noticeCategory": {
      "type": "object",
      "required": ["type", "icon"],
      "properties": {
        "type": { "type": "string", "description": "Plain-English notice type" },
        "legalSection": { "type": "string", "description": "Specific legal section if identifiable from document" },
        "icon": { "type": "string", "description": "Emoji or short icon key" }
      }
    },
    "plainEnglishSummary": {
      "type": "string",
      "description": "2–4 sentence plain-language explanation of what this notice means. No legal jargon. No outcome predictions."
    },
    "keyFacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "sourcePageLine": { "type": "string" }
        }
      }
    },
    "deadline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["days", "unit", "description", "triggerEvent", "exactQuote", "isCrucial", "warning"],
          "properties": {
            "days": { "type": "integer", "minimum": 1 },
            "unit": { "type": "string", "enum": ["days", "weeks", "months"] },
            "description": { "type": "string" },
            "triggerEvent": { "type": "string" },
            "exactQuote": { "type": "string", "description": "Verbatim text from document containing the deadline" },
            "isCrucial": { "type": "boolean" },
            "warning": { "type": "string" }
          }
        }
      ]
    },
    "documentExcerpts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["text", "relevance"],
        "properties": {
          "text": { "type": "string", "description": "VERBATIM quote from the document. No paraphrasing." },
          "pageRange": { "type": "string" },
          "relevance": { "type": "string" },
          "highlightTerms": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "attentionItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["title", "description", "severity", "order"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "order": { "type": "integer" }
        }
      }
    },
    "lawyerQuestions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "description": "Questions this person should ask a lawyer, based on what this specific document contains.",
      "items": {
        "type": "object",
        "required": ["question", "context", "order"],
        "properties": {
          "question": { "type": "string" },
          "context": { "type": "string" },
          "documentBasis": { "type": "string" },
          "order": { "type": "integer" }
        }
      }
    },
    "hindiTranslation": {
      "type": "object",
      "required": ["summaryHindi", "keyFactsHindi", "attentionItemsHindi"],
      "properties": {
        "summaryHindi": { "type": "string" },
        "keyFactsHindi": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "deadlineHindi": { "type": "string" },
        "attentionItemsHindi": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "description"],
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "legalHelpResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description", "relevance"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["DLSA", "NGO", "helpline", "online"] },
          "description": { "type": "string" },
          "contact": { "type": "string" },
          "url": { "type": "string" },
          "relevance": { "type": "string" }
        }
      }
    },
    "safetyDisclaimer": {
      "type": "string",
      "description": "Must always be: 'This is informational civic assistance only. NyayaLens is not a lawyer and this is not formal legal advice. Consult a qualified advocate for representation.'"
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence in document parsing quality"
    }
  }
}
